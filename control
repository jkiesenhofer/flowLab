#!/bin/bash

DEVICE="/dev/ttyUSB0"
BAUD=9600

# Configure serial port: 8N1, no parity, raw mode
stty -F $DEVICE $BAUD cs8 -cstopb -parenb -echo raw

send_cmd() {
    echo -ne "$1\r" > $DEVICE
    echo "Sent: $1"
}

read_response() {
    # Read up to 100 bytes or 1 second
    RESPONSE=$(timeout 1 cat $DEVICE)
    echo "Pump response: '$RESPONSE'"
}

# Reset pump
send_cmd "/1ZR"
sleep 2
read_response

# Check status
send_cmd "/1TS"
sleep 1
read_response

echo "Pump status check complete."
